@@ -838,22 +838,27 @@
 setnonblocking(int fd, int nonblocking)
 {
     int flags, newflags;
+    int on = nonblocking ? 1 : 0;
 
     flags = fcntl(fd, F_GETFL, 0);
-    if (flags < 0) {
-        perror("fcntl(F_GETFL)");
-        return -1;
+    if (flags >= 0) {
+	if (nonblocking)
+	    newflags = flags | (int) O_NONBLOCK;
+	else
+	    newflags = flags & ~((int) O_NONBLOCK);
+	if (newflags == flags || fcntl(fd, F_SETFL, newflags) == 0)
+	    return 0;
     }
-    if (nonblocking)
-	newflags = flags | (int) O_NONBLOCK;
-    else
